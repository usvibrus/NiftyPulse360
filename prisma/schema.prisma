generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StockEvent {
  id            String   @id @default(cuid())
  slug          String   @unique
  symbol        String
  companyName   String
  exchange      String
  sector        String?
  eventType     String
  changePercent Float
  changeAmount  Float
  openPrice     Float
  closePrice    Float
  highPrice     Float
  lowPrice      Float
  volume        BigInt
  avgVolume     BigInt?
  marketCap     Float?
  week52High    Float?
  week52Low     Float?
  sectorChange  Float?
  niftyChange   Float?
  aiAnalysis    String?
  faqContent    Json?
  newsItems     Json
  pageContent   String
  metaTitle     String
  metaDesc      String
  keywords      String[]
  eventDate     DateTime
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isPublished   Boolean  @default(true)
  pageViews     Int      @default(0)
  tweetPosted     Boolean  @default(false)
  googleIndexed   Boolean  @default(false)
  devtoPosted     Boolean  @default(false)
  tumblrPosted    Boolean  @default(false)
  telegraphPosted Boolean  @default(false)

  @@index([symbol])
  @@index([eventDate])
  @@index([eventType])
  @@index([changePercent])
  @@index([publishedAt])
}

model IndexEvent {
  id            String   @id @default(cuid())
  slug          String   @unique
  indexName     String
  indexSymbol   String
  eventType     String
  changePercent Float
  changePoints  Float
  openValue     Float
  closeValue    Float
  highValue     Float
  lowValue      Float
  newsItems     Json
  pageContent   String
  metaTitle     String
  metaDesc      String
  keywords      String[]
  eventDate     DateTime
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isPublished   Boolean  @default(true)
  pageViews     Int      @default(0)
  tweetPosted   Boolean  @default(false)
  googleIndexed Boolean  @default(false)

  @@index([indexSymbol])
  @@index([eventDate])
}

model MetalEvent {
  id            String   @id @default(cuid())
  slug          String   @unique
  metal         String
  carat         String?
  eventType     String
  changePercent Float
  pricePerGram  Float
  pricePerTola  Float?
  pricePerOunce Float
  newsItems     Json
  pageContent   String
  metaTitle     String
  metaDesc      String
  keywords      String[]
  eventDate     DateTime
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isPublished   Boolean  @default(true)
  pageViews     Int      @default(0)
  tweetPosted   Boolean  @default(false)
  googleIndexed Boolean  @default(false)

  @@index([metal])
  @@index([eventDate])
}

model CommodityEvent {
  id            String   @id @default(cuid())
  slug          String   @unique
  commodity     String
  eventType     String
  changePercent Float
  priceUSD      Float
  priceINR      Float?
  newsItems     Json
  pageContent   String
  metaTitle     String
  metaDesc      String
  keywords      String[]
  eventDate     DateTime
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isPublished   Boolean  @default(true)
  pageViews     Int      @default(0)
  tweetPosted   Boolean  @default(false)
  googleIndexed Boolean  @default(false)

  @@index([commodity])
  @@index([eventDate])
}

model CurrencyEvent {
  id            String   @id @default(cuid())
  slug          String   @unique
  pair          String
  eventType     String
  changePercent Float
  rateValue     Float
  newsItems     Json
  pageContent   String
  metaTitle     String
  metaDesc      String
  keywords      String[]
  eventDate     DateTime
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isPublished   Boolean  @default(true)
  pageViews     Int      @default(0)
  tweetPosted   Boolean  @default(false)
  googleIndexed Boolean  @default(false)

  @@index([pair])
  @@index([eventDate])
}

model IndexingQueue {
  id          String    @id @default(cuid())
  url         String    @unique
  pageType    String
  attempts    Int       @default(0)
  lastAttempt DateTime?
  success     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([success])
}

model IpoEvent {
  id              String   @id @default(cuid())
  slug            String   @unique
  companyName     String
  symbol          String?
  ipoType         String
  exchange        String
  status          String

  priceBandMin    Float?
  priceBandMax    Float?
  issuePrice      Float?
  lotSize         Int?
  issueSizeCr     Float?
  freshIssue      Float?
  offerForSale    Float?

  openDate        DateTime?
  closeDate       DateTime?
  allotmentDate   DateTime?
  refundDate      DateTime?
  listingDate     DateTime?

  gmpValue        Float?
  gmpPercent      Float?
  gmpHistory      Json?
  gmpUpdatedAt    DateTime?

  subscriptionData      Json?
  subscriptionUpdatedAt DateTime?

  listingPrice    Float?
  listingGainLoss Float?
  listingDayClose Float?
  currentPrice    Float?

  aboutCompany    String?
  promoterHolding Float?
  financials      Json?
  objectOfIssue   String?

  registrarName   String?
  registrarUrl    String?
  leadManagers    String[]

  aiAnalysis      String?
  faqContent      Json?
  pageContent     String?
  metaTitle       String
  metaDesc        String
  keywords        String[]

  publishedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isPublished     Boolean   @default(true)
  pageViews       Int       @default(0)
  googleIndexed   Boolean   @default(false)
  tweetPosted     Boolean   @default(false)

  listingSlug         String?  @unique
  listingPageContent  String?
  listingMetaTitle    String?
  listingMetaDesc     String?
  listingPublishedAt  DateTime?

  @@index([status])
  @@index([ipoType])
  @@index([openDate])
  @@index([listingDate])
  @@index([publishedAt])
}

model MarketWrap {
  id              String   @id @default(cuid())
  slug            String   @unique
  wrapDate        DateTime @unique

  niftyClose      Float?
  niftyChange     Float?
  niftyChangePct  Float?
  sensexClose     Float?
  sensexChange    Float?
  sensexChangePct Float?
  bankNiftyClose  Float?
  bankNiftyChange Float?

  topGainers      Json?
  topLosers       Json?
  sectorSummary   Json?

  aiSummary       String?
  pageContent     String
  metaTitle       String
  metaDesc        String
  keywords        String[]

  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isPublished     Boolean  @default(true)
  googleIndexed   Boolean  @default(false)

  @@index([wrapDate])
}

model PreMarketData {
  id              String   @id @default(cuid())
  slug            String   @unique
  dataDate        DateTime @unique

  giftNifty       Float?
  giftNiftyChange Float?
  giftNiftyPct    Float?
  dowJones        Float?
  dowChange       Float?
  sp500           Float?
  sp500Change     Float?
  nasdaq          Float?
  nasdaqChange    Float?

  crudeOil        Float?
  crudeChange     Float?
  goldPrice       Float?
  goldChange      Float?

  usdInr          Float?
  usdInrChange    Float?

  nikkei          Float?
  nikkeiChange    Float?
  hangSeng        Float?
  hangSengChange  Float?

  aiExpectation   String?
  pageContent     String
  metaTitle       String
  metaDesc        String
  keywords        String[]

  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isPublished     Boolean  @default(true)
  googleIndexed   Boolean  @default(false)

  @@index([dataDate])
}
